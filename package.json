{
  "name": "udyam-digital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:journey": "tsx scripts/journey-check.ts",
    "check:ai": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-ai.ts",
    "gen:data": "tsx scripts/gen-catalogue.ts && tsx scripts/gen-ocr-cache.ts && tsx scripts/train-propensity.ts && tsx scripts/train-churn.ts",
    "seed:roster": "tsx scripts/seed-roster.ts",
    "setup:channels": "tsx scripts/setup-channels.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "test:e2e": "playwright test",
    "telegram:poll": "tsx scripts/telegram-poll.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/db-seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:import-legacy": "NODE_OPTIONS=--conditions=react-server tsx scripts/import-legacy-docs.ts",
    "vercel-build": "npm run db:migrate && npm run db:seed && next build",
    "check:routes": "tsx scripts/route-audit.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@libsql/client": "^0.18.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.68.0",
    "nanoid": "^6.0.2",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9 <27"
  }
}
