# Everything below is OPTIONAL. With no keys at all, the full demo runs offline:
#   deterministic English/Hindi advisor; document uploads are refused (no fake extraction) until a reader is configured.

# --- AI: Google Gemini (free tier — get a key at https://aistudio.google.com/apikey) ---
# Server-side only; never exposed to the browser. Put real keys in .env.local (git-ignored), not here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash      # run `npm run check:ai` to confirm your key can use this model

# --- Demo behaviour ---
DEMO_MODE=true           # false disables demo staff logins, the demo reset endpoint and the sample-document picker
NEXT_PUBLIC_REFERENCE_DATE=2026-07-15   # the dataset's "today" (address-proof age, ETAs). Never the system clock.

# --- Database ---
# Local default: file:.data/udyam.db (created automatically).
# For a deployed demo use a persistent libSQL/Turso database — serverless disks don't persist:
DATABASE_URL=            # libsql://<db>-<org>.turso.io  (local default: file:.data/udyam.db)
DATABASE_AUTH_TOKEN=     # `turso db tokens create <db>`
DB_AUTO_MIGRATE=         # leave empty: dev auto-migrates, production expects `npm run db:migrate` (done by vercel-build)

# --- Staff accounts (ops console) ---
# The first admin is created by `npm run db:seed` (runs on every Vercel build; never overwrites an existing account).
ADMIN_EMAIL=
ADMIN_PASSWORD=          # 10+ characters; change it after first sign-in
ADMIN_NAME=

# Test-only seam for scripted journeys (skips the SMS round-trip). Ignored in production builds. Never set it on Vercel.
ALLOW_TEST_VERIFY=
TWOFACTOR_API_KEY=       # 2factor.in dashboard → API; SMS OTP (server-only)

# WhatsApp (Twilio sandbox or production sender): advisor front end + proactive order updates
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=     # e.g. whatsapp:+14155238886 (sandbox)
PUBLIC_BASE_URL=          # public https origin Twilio can reach (tunnel or Vercel URL)

# DigiLocker (needs API Setu partner onboarding — registered organisation)
# DigiLocker + EntityLocker through a licensed provider (no organisation needed): https://console.sandbox.co.in -> Settings -> API Keys.
# A key_test... key uses the free test host, key_live... the billed production host. Needs PUBLIC_BASE_URL to be a public https address.
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
# Or, only if you hold API Setu partner credentials yourself:
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=  # https://<your-domain>/api/digilocker/callback

# WhatsApp via Meta Cloud API (preferred: free, anyone can message, no sandbox join). Webhook: <PUBLIC_BASE_URL>/api/channels/whatsapp/meta
META_WA_TOKEN=            # permanent System User token with whatsapp_business_messaging
META_WA_PHONE_NUMBER_ID=  # from WhatsApp → API Setup (the REAL number, not the test number)
META_WA_APP_SECRET=       # App settings → Basic → App secret (signs webhooks)
META_WA_VERIFY_TOKEN=     # any random string; paste the same in the webhook config
META_APP_ID=                 # optional: lets `npm run setup:channels` register the Meta webhook for you
META_WA_BUSINESS_ACCOUNT_ID= # optional: lets the script subscribe the WhatsApp Business Account

# Telegram bot (free, no approval): @BotFather → /newbot → token
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=     # any random string (A-Z a-z 0-9 _ -), echoed back by Telegram on every webhook call

# Public chat links shown on the landing page and tracker
NEXT_PUBLIC_WHATSAPP_NUMBER=   # digits with country code, e.g. 919876543210 (Twilio sandbox: 14155238886)
NEXT_PUBLIC_WHATSAPP_JOIN=     # Twilio sandbox only: the join phrase, e.g. "join silver-tiger"
NEXT_PUBLIC_TELEGRAM_BOT=      # bot username without @

# --- Automation & policy (all optional; sensible defaults) ---
CRON_SECRET=                 # required for /api/cron/housekeeping (resume reminders + stuck-order sweep). Vercel Cron sends it as a Bearer token. Hobby plan runs it once a day; point any scheduler at it for hourly.
NUDGE_AFTER_MINUTES=120      # idle time before the one-time resume reminder
STAGE_SLA_HOURS=48           # an order idle in one stage longer than this gets a proactive delay notice
NEXT_PUBLIC_DEPOSIT_PERCENT=20       # reserve-now share of the first payment
NEXT_PUBLIC_DEPOSIT_MIN=500          # smallest reservation, rupees
NEXT_PUBLIC_DEPOSIT_OFFER_FROM=2000  # smallest first payment that is offered the split
PARTNER_COMMISSION_PERCENT=  # Accel Business policy; leave empty and the partner book shows no earnings rather than inventing a rate
