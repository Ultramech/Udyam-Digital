# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/test-results/
/playwright-report/
/.playwright-mcp/
/.next-test/
/.next-build/

# extra build dirs from NEXT_DIST_DIR (test servers, local production builds)
/.next-*/

# local database, OCR run results and other machine-local state (contains personal data)
/.data/
# the env template is safe to share; real env files are not
!.env.example
*.db
*.db-journal
.tmp-*
